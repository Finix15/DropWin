{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "macos",
  "description": "Capabilities for dynamic Drop and supporting windows on macOS",
  "platforms": ["macOS"],
  "windows": [
    "drop-*",
    "popup-*",
    "settings"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-theme",
    "fs:read-meta",
    "fs:allow-read-file",
    "fs:allow-read",
    "fs:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:default",
    "key-intercept:default",
    "key-intercept:allow-check-permission",
    "key-intercept:allow-open-input-monitoring-settings",
    "key-intercept:allow-register",
    "key-intercept:allow-unregister",
    "key-intercept:allow-is-registered",
    "key-intercept:allow-get-keycode-table",
    "key-intercept:allow-discover-keycode"
  ]
}
